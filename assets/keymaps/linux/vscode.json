[
  {
    "context": "Editor",
    "use_key_equivalents": true,
    "bindings": {
      "shift-alt-f": "editor::Format",
      "ctrl-k ctrl-f": "editor::FormatSelections",
      "shift-alt-i": "editor::SplitSelectionIntoLines",
      "alt-z": "editor::ToggleSoftWrap",
      "ctrl-shift-space": "editor::ShowSignatureHelp",
      "ctrl-shift-a": "editor::ToggleBlockComments",
      "ctrl-k ctrl-c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false,
          "comment_empty_lines": false
        }
      ],
      "ctrl-/": [
        "editor::ToggleComments",
        {
          "advance_downwards": false,
          "comment_empty_lines": false
        }
      ],
      "ctrl-k f12": "editor::GoToDefinitionSplit"
    }
  },
  {
    "context": "Editor && mode == full",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-k z": "workspace::ToggleCenteredLayout",
      "ctrl-i": "assistant::InlineAssist",
      "shift-alt-h": "call_hierarchy::ShowIncomingCalls"
    }
  },
  {
    "context": "Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-enter": null
    }
  },
  {
    "context": "Workspace && debugger_running",
    "use_key_equivalents": true,
    "bindings": {
      "f5": null
    }
  },
  {
    "context": "CallHierarchyPicker > Picker > Editor",
    "use_key_equivalents": true,
    "bindings": {
      "shift-alt-h": "call_hierarchy::ToggleDirection"
    }
  }
]
